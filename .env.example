# ==============================================================================
# DriftOps - Environment Configuration
# Project ID: F26-176-DriftOps
# ==============================================================================

# --- PostgreSQL Connection ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=driftops_db

# --- Docker Sandbox Settings ---
# On Linux/macOS: unix:///var/run/docker.sock
# On Windows (Docker Desktop named pipe): npipe:////./pipe/docker_engine or unix:///var/run/docker.sock
DOCKER_SOCKET=unix:///var/run/docker.sock
SANDBOX_POSTGRES_IMAGE=postgres:15-alpine

# --- Risk Gate Thresholds ---
# Minimum AST structural similarity required to proceed through gate (0.0 - 1.0)
HARD_GATE_C_AST_FLOOR=0.80
# Upper risk threshold for Tier 1 autonomous inline repairs (0.0 - 1.0)
TIER_1_MAX_RISK=0.20
# Upper risk threshold for Tier 2 bounded candidate repairs (0.0 - 1.0)
TIER_2_MAX_RISK=0.60

# --- GitHub & App Settings ---
GITHUB_TOKEN=mock_token
LOG_LEVEL=INFO
